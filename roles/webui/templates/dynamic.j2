http:
  services:
    piaas:
      loadBalancer:
        servers:
        - url: "http://{{ piaas_ip_address }}:{{ piaas_port }}/"
  routers:
    piaas:
      rule: Host(`{{ piaas_external_fqdn }}`)
      service: piaas
      entrypoints: "websecure"
      tls:
        certresolver: "epicresolver"
      middlewares:
        - auth
    dashboard:
      rule: Host(`{{ piaas_internal_fqdn }}`) && (PathPrefix(`/api/`) || PathPrefix(`/dashboard/`))
      service: api@internal
      entrypoints: "websecure"
      tls: {} 
      middlewares:
        - auth
  middlewares:
    auth:
      basicAuth:
        users:
          - "admin:$apr1$.R3sPsH1$r65UmltVLdeOcywKCI5Ny/"
          - "epic:$apr1$BsVXdMBC$8ZJckKORv./GOkFqA/NC2/"
